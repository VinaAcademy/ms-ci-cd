# Droplet A Connection
DROPLET_A_IP=your_droplet_a_public_ip

# Database
PLATFORM_DB_URL=jdbc:postgresql://${DROPLET_A_IP}:5432/vinaacademy_platform
NOTIFICATION_DB_URL=jdbc:postgresql://${DROPLET_A_IP}:5432/vinaacademy_email
CHAT_DB_URL=jdbc:postgresql://${DROPLET_A_IP}:5432/vinaacademy_chat
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_database_password

# Redis
REDIS_PASSWORD=your_secure_redis_password

# MinIO
MINIO_ENDPOINT=http://${DROPLET_A_IP}:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_secure_minio_password

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=your_redirect_uri

# VNPay
VNPAY_TMN_CODE=your_vnpay_code
VNPAY_HASH_SECRET=your_vnpay_secret
VNPAY_URL_RETURN=http://your_droplet_b_ip/transaction

# Application
APPLICATION_HMAC_SECRET=your_hmac_secret

# Gmail
GMAIL_USERNAME=your_gmail
GMAIL_PASSWORD=your_gmail_app_password

# Frontend URLs
NEXT_PUBLIC_API_URL=http://your_droplet_b_ip:8080/api/v1
NEXT_PUBLIC_SITE_URL=http://your_droplet_b_ip:3000
NEXT_PUBLIC_WS_URL=http://your_droplet_b_ip:8080/ws