# ==============================================================================
# DOCKER STACK DEPLOYMENT CONFIGURATION
# For two-droplet setup with external cloud services
# ==============================================================================

# ------------------------------------------------------------------------------
# External PostgreSQL Configuration (Cloud Service)
# Replace with your managed PostgreSQL service (DigitalOcean, AWS RDS, etc.)
# ------------------------------------------------------------------------------
POSTGRES_URL=jdbc:postgresql://your-postgres-host.db.ondigitalocean.com:25060/vinaacademy?sslmode=require
POSTGRES_NOTIFICATION_URL=jdbc:postgresql://your-postgres-host.db.ondigitalocean.com:25060/vinaacademy_email?sslmode=require
POSTGRES_CHAT_HOST=your-postgres-host.db.ondigitalocean.com:25060
POSTGRES_CHAT_DB=vinaacademy_chat
POSTGRES_USERNAME=doadmin
POSTGRES_PASSWORD=your-postgres-password

# ------------------------------------------------------------------------------
# External MinIO/S3 Configuration (Cloud Object Storage)
# Use MinIO Cloud, AWS S3, DigitalOcean Spaces, or any S3-compatible service
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=https://your-space-name.sgp1.digitaloceanspaces.com
MINIO_ACCESS_KEY=your-spaces-access-key
MINIO_SECRET_KEY=your-spaces-secret-key
MINIO_BUCKET=vinaacademy
MINIO_REGION=sgp1

# ------------------------------------------------------------------------------
# Google OAuth2 Configuration
# ------------------------------------------------------------------------------
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://your-domain.com/oauth2/callback/google

# ------------------------------------------------------------------------------
# VNPay Configuration
# ------------------------------------------------------------------------------
# Get these from your VNPay account
VNPAY_TMN_CODE=your-vnpay-tmn-code-here
VNPAY_HASH_SECRET=your-vnpay-hash-secret-here
VNPAY_URL_RETURN=http://your-domain.com/transaction

# ------------------------------------------------------------------------------
# Application URLs (Update with your actual domain or Droplet IP)
# ------------------------------------------------------------------------------
APPLICATION_URL_FRONTEND=http://your-droplet-ip:3000
APPLICATION_URL_BACKEND=http://your-droplet-ip:8081
APPLICATION_URL_GOOGLE_AUTH=http://your-droplet-ip:3000/login/google

# ------------------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret key for production!
APPLICATION_HMAC_SECRET=your-super-secret-key-for-hmac-change-this-in-production
APPLICATION_JWT_ACCESS_EXPIRATION=86400
APPLICATION_JWT_REFRESH_EXPIRATION=2592000

# ------------------------------------------------------------------------------
# Email Configuration (Gmail)
# ------------------------------------------------------------------------------
# For Gmail: Enable 2FA and generate an App Password
# Guide: https://support.google.com/accounts/answer/185833
GMAIL_USERNAME=your-email@gmail.com
GMAIL_PASSWORD=your-app-password-here

# ------------------------------------------------------------------------------
# Frontend Public URLs (for Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://your-droplet-ip:3000
NEXT_PUBLIC_API_URL=http://your-droplet-ip:8080/api/v1
NEXT_PUBLIC_WS_URL=http://your-droplet-ip:8080/ws

# ==============================================================================
# LEGACY/LOCAL DEVELOPMENT CONFIGURATION (Not used in Docker Stack)
# ==============================================================================
# These are kept for reference if you want to run locally with Docker Compose

# Database Configuration (using Docker service names)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/vinaacademy
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis Configuration (using Docker service names)
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# MinIO Configuration (using Docker service names - for local development only)
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=password123
# MINIO_ENDPOINT=http://minio:9000
# MINIO_ACCESS_KEY=admin
# MINIO_SECRET_KEY=password123
# MINIO_BUCKET=vinaacademy
# MINIO_REGION=ap-southeast-1